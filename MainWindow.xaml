<Window x:Class="myPiano.MainWindow" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Пианино" Height="540" Width="900"
        MinHeight="520" MinWidth="840"
        Background="#FFF7F8FA">

    <Window.Resources>
        <Style x:Key="ChordButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="WhiteKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB9BEC7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BlackKeyStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF202020"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel x:Name="MainContent" LastChildFill="True">
            <Border DockPanel.Dock="Bottom"
                    Height="28"
                    BorderBrush="#FFD7DCE2"
                    BorderThickness="0,1,0,0"
                    Background="#FFF0F2F5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Программа готова к работе" Foreground="#FF555555"/>
                </StackPanel>
            </Border>

            <Grid Margin="20">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Content="О программе"
                            Width="110"
                            Height="32"
                            Margin="5"
                            Click="About_Click"/>
                    <Button Content="Очистить"
                            Width="90"
                            Height="32"
                            Margin="5"
                            Click="Clear_Click"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="Введите ноты через пробел. Для паузы используйте символ &quot;-&quot;."
                               Foreground="#FF4D5663"
                               FontSize="14"
                               Margin="5,0,5,4"/>
                    <TextBlock Text="Формат: C4, A4, G4; пауза: -; увеличение длительности: двоеточие после ноты. Пример: C4 - A4 - G4 : F4"
                               Foreground="#FF6A7280"
                               FontSize="12"
                               Margin="5,0,5,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="MelodyInput"
                                 Width="500"
                                 Height="35"
                                 FontSize="16"
                                 Margin="5"
                                 VerticalContentAlignment="Center"
                                 TextChanged="MelodyInput_TextChanged"/>

                        <Button Content="Play melody"
                                Width="120"
                                Height="35"
                                Margin="5"
                                Click="PlayMelody_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="InputErrorText"
                               Text="Введите хотя бы одну ноту"
                               Foreground="#FFD21F3C"
                               Visibility="Collapsed"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,22">
                    <Button Content="C" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="Dm" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="Em" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="F" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="G" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="Am" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                    <Button Content="Bdim" Style="{StaticResource ChordButtonStyle}" Click="Chord_Click"/>
                </StackPanel>

                <Grid Width="700" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button x:Name="C4" Content="C4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="D4" Content="D4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="E4" Content="E4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="F4" Content="F4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="G4" Content="G4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="A4" Content="A4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="B4" Content="B4" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="C5" Content="C5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="D5" Content="D5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="E5" Content="E5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="F5" Content="F5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="G5" Content="G5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="A5" Content="A5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                        <Button x:Name="B5" Content="B5" Style="{StaticResource WhiteKeyStyle}" Click="Note_Click"/>
                    </StackPanel>

                    <Canvas Width="700" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button x:Name="Db4" Content="C#4" Style="{StaticResource BlackKeyStyle}" Canvas.Left="35" Click="Note_Click"/>
                        <Button x:Name="Eb4" Content="D#4" Style="{StaticResource BlackKeyStyle}" Canvas.Left="85" Click="Note_Click"/>
                        <Button x:Name="Gb4" Content="F#4" Style="{StaticResource BlackKeyStyle}" Canvas.Left="185" Click="Note_Click"/>
                        <Button x:Name="Ab4" Content="G#4" Style="{StaticResource BlackKeyStyle}" Canvas.Left="235" Click="Note_Click"/>
                        <Button x:Name="Bb4" Content="A#4" Style="{StaticResource BlackKeyStyle}" Canvas.Left="285" Click="Note_Click"/>
                        <Button x:Name="Db5" Content="C#5" Style="{StaticResource BlackKeyStyle}" Canvas.Left="385" Click="Note_Click"/>
                        <Button x:Name="Eb5" Content="D#5" Style="{StaticResource BlackKeyStyle}" Canvas.Left="435" Click="Note_Click"/>
                        <Button x:Name="Gb5" Content="F#5" Style="{StaticResource BlackKeyStyle}" Canvas.Left="535" Click="Note_Click"/>
                        <Button x:Name="Ab5" Content="G#5" Style="{StaticResource BlackKeyStyle}" Canvas.Left="585" Click="Note_Click"/>
                        <Button x:Name="Bb5" Content="A#5" Style="{StaticResource BlackKeyStyle}" Canvas.Left="635" Click="Note_Click"/>
                    </Canvas>
                </Grid>
            </Grid>
        </DockPanel>

        <Grid x:Name="SplashScreen"
              Background="#FFF7F8FA"
              Panel.ZIndex="10">
            <Border Width="430"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#FFD7DCE2"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Пианино"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#FF20242A"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Приложение для воспроизведения отдельных нот, аккордов и записанных мелодий."
                               TextWrapping="Wrap"
                               FontSize="15"
                               Foreground="#FF4D5663"
                               Margin="0,0,0,18"/>
                    <TextBlock Text="Автор: Усанков Леонид" Margin="0,0,0,4"/>
                    <TextBlock Text="Версия: 1.0" Margin="0,0,0,22"/>
                    <Button Content="Перейти к основному окну"
                            Width="220"
                            Height="38"
                            HorizontalAlignment="Left"
                            Click="StartButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
