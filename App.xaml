<Application x:Class="myPiano.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:myPiano"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ColorAnimation x:Key="PressAnimation"
                        To="#FFFFD84D"
                        Duration="0:0:0.1"
                        AutoReverse="False"/>

        <ColorAnimation x:Key="PressBlackAnimation"
                        To="#FF4169E1"
                        Duration="0:0:0.1"
                        AutoReverse="False"/>
        
        <ColorAnimation x:Key="ReleaseAnimation"
                        To="White"
                        Duration="0:0:0.15"
                        AutoReverse="False"/>
        
        <ColorAnimation x:Key="ReleaseBlackAnimation"
                        To="Black"
                        Duration="0:0:0.15"
                        AutoReverse="False"/>
    </Application.Resources>
</Application>
